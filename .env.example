# Generate .env with: node scripts/orbis.mjs init
# Empty secrets must be filled. Never use this file as production credentials.
ORBIS_POSTGRES_USER=orbis
ORBIS_POSTGRES_DB=orbis
ORBIS_POSTGRES_PASSWORD=
ORBIS_S3_ACCESS_KEY=
ORBIS_S3_SECRET_KEY=
ORBIS_S3_BUCKET=orbis-docs
ORBIS_ADMIN_USERNAME=admin
ORBIS_ADMIN_PASSWORD=
ORBIS_WEB_PORT=18080
ORBIS_API_PORT=18081
ORBIS_PG_PORT=18432
ORBIS_REDIS_PORT=18379
ORBIS_S3_PORT=18900
ORBIS_S3_CONSOLE_PORT=18901
ORBIS_QDRANT_PORT=18333
ORBIS_QDRANT_GRPC_PORT=18334
ORBIS_JAEGER_PORT=18686
ORBIS_PROMETHEUS_PORT=18909
ORBIS_GRAFANA_PORT=18304
ORBIS_GRAFANA_PASSWORD=
# With obs profile the start script sets the internal Jaeger endpoint.
ORBIS_OTEL_ENDPOINT=
